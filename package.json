{
  "name": "skill-shelf",
  "version": "2.0.0",
  "license": "MIT",
  "mcpName": "io.github.halflifezyf2680/skill-shelf",
  "type": "module",
  "description": "Local MCP server using a Rust singleton daemon and a lightweight npm stdio shim with progressive group routing.",
  "bin": {
    "skill-shelf": "bin/skill-shelf.js"
  },
  "files": [
    "bin/",
    "server.json",
    "data/hub/config/",
    "data/hub/packages/",
    "rust/skill-shelf/target/release/skill-shelf*"
  ],
  "scripts": {
    "skill-shelf": "node ./bin/skill-shelf.js",
    "mcp": "node ./bin/skill-shelf.js mcp",
    "daemon": "node ./bin/skill-shelf.js daemon",
    "status": "node ./bin/skill-shelf.js status",
    "stop": "node ./bin/skill-shelf.js stop",
    "rust:build": "cargo build --release --manifest-path rust/skill-shelf/Cargo.toml",
    "rust:build:debug": "cargo build --manifest-path rust/skill-shelf/Cargo.toml",
    "rust:test": "cargo test --manifest-path rust/skill-shelf/Cargo.toml"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gray-matter": "^4.0.3"
  }
}