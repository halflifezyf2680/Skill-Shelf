{
  "name": "remotion-infographic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts --port=4000",
    "render": "remotion render src/index.ts InfographicVideo out/infographic.mp4 --port=4001",
    "still": "remotion still src/index.ts InfographicVideo out/frame.png --frame=120 --port=4001",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.457",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.457"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.3"
  }
}
